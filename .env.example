# All runtime configuration lives here. Copy to .env and adjust.
VITE_APP_NAME=Meridian Capital
# Seed for the single shared deterministic dataset. Same seed => identical numbers everywhere.
VITE_DATA_SEED=20240615
# Simulated network latency for the mock API, in milliseconds.
VITE_API_LATENCY_MS=180
# Probability (0-1) that a mock request fails, to exercise widget error states.
VITE_MOCK_ERROR_RATE=0
# Fixed USD/INR conversion used for all USD figures (assumption, not a live rate).
VITE_USD_INR_RATE=83.5
# How often simulated intraday prices tick, in milliseconds.
VITE_TICK_INTERVAL_MS=5000
# When true, intraday ticks continue outside NSE hours so the demo is never frozen.
# The command bar still shows the real NSE session status.
VITE_SIMULATE_MARKET_OPEN=true
# Zustand Redux-DevTools bridge (dev builds only). Needs the browser extension; set true to use it.
VITE_ENABLE_DEVTOOLS=false
