# All runtime configuration lives here. Copy to .env and adjust.
# Every value is validated at startup (src/utils/env.ts); an invalid value stops the app with a
# message naming the variable.

# API base path. The mock API runs in the browser (no network requests); this base appears in
# request labels and error messages, e.g. GET /api/risk/var.
VITE_API_BASE_URL=/api
# Live market-data WebSocket. Reserved for a real feed: the app does not open it in mock mode.
VITE_WS_URL=ws://localhost:5173/ws
# Theme for first-time visitors: light (Porcelain), dark (Midnight Graphite) or high-contrast.
# A theme the user picks is remembered and takes precedence.
VITE_DEFAULT_THEME=light
# Refresh interval (ms) for widgets backed by end-of-day data: NAV, drawdown, VaR, risk
# metrics, attribution and research. Intraday widgets keep their own 5-15 s intervals.
VITE_DATA_REFRESH_INTERVAL=30000
# Maximum number of widgets on one page.
VITE_MAX_WIDGETS=20
# Sign in automatically as the demo portfolio manager (there is no real authentication).
VITE_ENABLE_MOCK_AUTH=true

VITE_APP_NAME=Meridian Capital
# Seed for the single shared deterministic dataset. Same seed => identical numbers everywhere.
VITE_DATA_SEED=20240615
# Simulated network latency for the mock API, in milliseconds.
VITE_API_LATENCY_MS=180
# Probability (0-1) that a mock request fails, to exercise widget error states.
VITE_MOCK_ERROR_RATE=0
# Fixed USD/INR conversion used for all USD figures (assumption, not a live rate).
VITE_USD_INR_RATE=83.5
# How often simulated intraday prices tick, in milliseconds.
VITE_TICK_INTERVAL_MS=5000
# When true, intraday ticks continue outside NSE hours so the demo is never frozen.
# The command bar still shows the real NSE session status.
VITE_SIMULATE_MARKET_OPEN=true
# Zustand Redux-DevTools bridge (dev builds only). Needs the browser extension; set true to use it.
VITE_ENABLE_DEVTOOLS=false
